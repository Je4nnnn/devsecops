# Identificador de las imagenes del paquete. El generador offline lo reemplaza.
APP_VERSION=entrega3-portable-v7
COMPOSE_PROJECT_NAME=vuln-app-wazuh

# PostgreSQL / TimescaleDB
POSTGRES_DB=vulnerabilidades_db
POSTGRES_USER=vuln_app
POSTGRES_PASSWORD=REEMPLAZAR_POSTGRES_PASSWORD
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Aplicacion
APP_ENV=production
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_ADMIN_PASSWORD
JWT_SECRET=REEMPLAZAR_JWT_SECRET
ENCRYPTION_KEY=REEMPLAZAR_ENCRYPTION_KEY
CORS_ORIGINS=

# Wazuh. En produccion use true o la ruta a una CA confiable.
WAZUH_VERIFY_TLS=false
WAZUH_BATCH_SIZE=2000
WAZUH_REQUEST_TIMEOUT=120

# CI/CD local
SONAR_DB_PASSWORD=REEMPLAZAR_SONAR_DB_PASSWORD
SONAR_ADMIN_PASSWORD=REEMPLAZAR_SONAR_ADMIN_PASSWORD
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=REEMPLAZAR_JENKINS_ADMIN_PASSWORD
PIPELINE_GIT_URL=https://github.com/Je4nnnn/devsecops
PIPELINE_GIT_BRANCH=*/codex/entrega3-portable-qa

# Acceso desde Kali/LAN
BIND_ADDRESS=0.0.0.0
FRONTEND_HTTP_PORT=18080
FRONTEND_HTTPS_PORT=18443
SONAR_PORT=9000
SONAR_NETWORK_NAME=vuln-app-wazuh_sonar-network
JENKINS_PORT=8080
JENKINS_CONTAINER_NAME=jenkins
VITE_API_URL=/api
TLS_CERT_DIR=./nginx/ssl

# Imagenes de ejecucion. No se descargan en el despliegue offline.
DB_IMAGE=timescale/timescaledb@sha256:867dc9cbb3232dece516122d49e56ce472754fe31cbffb54d64920f8d2ed79b6
API_IMAGE=matiassandovalp/devsecops-api:entrega3-portable-v6
FRONTEND_IMAGE=matiassandovalp/devsecops-frontend:entrega3-portable-v6
SONAR_DB_IMAGE=postgres:15
SONAR_IMAGE=sonarqube:9.9-community
JENKINS_IMAGE=matiassandovalp/devsecops-jenkins:entrega3-portable-v7
